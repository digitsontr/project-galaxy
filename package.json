{
  "name": "project-galaxy",
  "productName": "Project Galaxy",
  "version": "2.3.7",
  "description": "Projelerini bir evren olarak gezdiğin, AI ajanlarıyla yönettiğin masaüstü uygulaması",
  "main": "main.js",
  "author": "Furkan Yıldız",
  "scripts": {
    "start": "electron .",
    "make-app": "electron-packager . \"Project Galaxy\" --platform=darwin --arch=arm64 --icon=build/galaxy.icns --out=dist --overwrite --prune --app-bundle-id=com.furkan.projectgalaxy --ignore=\"^/dist\" --ignore=\"\\.command$\" --ignore=\"backup\" --ignore=\"^/build/icon_preview\"",
    "dist": "electron-builder --mac dmg",
    "release:mas": "node scripts/build-mas.js",
    "dist:mas": "node scripts/build-mas.js"
  },
  "build": {
    "appId": "com.furkan.projectgalaxy",
    "productName": "Project Galaxy",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/galaxy.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.plist",
      "entitlementsInherit": "build/entitlements.plist",
      "notarize": true
    },
    "mas": {
      "category": "public.app-category.developer-tools",
      "icon": "build/galaxy.icns",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSMinimumSystemVersion": "12.0"
      }
    },
    "dmg": {
      "title": "Project Galaxy"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "furkanyildiz",
        "repo": "project-galaxy"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "onboarding.html",
      "galaxy-hud.js",
      "galaxy-data.js",
      "assets/guide/**",
      "build/tray.png",
      "!dist",
      "!backups",
      "!reports",
      "!*.command",
      "!index.v2.backup.html"
    ],
    "extraMetadata": {
      "main": "main.js"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.6.0",
    "@electron/packager": "^18.3.6",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
