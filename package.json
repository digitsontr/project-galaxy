{
  "name": "project-galaxy",
  "productName": "Project Galaxy",
  "version": "2.1.0",
  "description": "Projelerini bir evren olarak gezdiğin, AI ajanlarıyla yönettiğin masaüstü uygulaması",
  "main": "main.js",
  "author": "Furkan Yıldız",
  "scripts": {
    "start": "electron .",
    "make-app": "electron-packager . \"Project Galaxy\" --platform=darwin --arch=arm64 --icon=build/galaxy.icns --out=dist --overwrite --prune --app-bundle-id=com.furkan.projectgalaxy --ignore=\"^/dist\" --ignore=\"\\.command$\" --ignore=\"backup\" --ignore=\"^/build/icon_preview\"",
    "dist": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.furkan.projectgalaxy",
    "productName": "Project Galaxy",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/galaxy.icns",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.plist",
      "entitlementsInherit": "build/entitlements.plist"
    },
    "dmg": { "title": "Project Galaxy" },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "galaxy-data.js",
      "build/tray.png",
      "!dist",
      "!backups",
      "!reports",
      "!*.command",
      "!index.v2.backup.html"
    ],
    "extraMetadata": { "main": "main.js" }
  },
  "dependencies": {
    "pg": "^8.13.1",
    "mysql2": "^3.11.5",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "@electron/packager": "^18.3.6",
    "electron-builder": "^25.1.8"
  }
}
